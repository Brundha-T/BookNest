services:
  booknest:
    build: .
    container_name: booknest-app
    ports:
      - "5000:5000"
    environment:
      SECRET_KEY: ${SECRET_KEY:-local-development-change-me}
      ADMIN_EMAIL: ${ADMIN_EMAIL:-admin@booknest.local}
      ADMIN_PASSWORD: ${ADMIN_PASSWORD:-Admin123!}
      BOOKNEST_DB: /app/data/booknest.db
    volumes:
      - ./data:/app/data
    restart: unless-stopped
